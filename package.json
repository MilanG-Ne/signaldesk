{
  "name": "signaldesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A browser-only request explorer built with React and TypeScript",
  "license": "MIT",
  "author": "Milan Georgijevic",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3002 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3002 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "@tanstack/react-virtual": "3.14.13"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19",
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "30.0.1",
    "@playwright/test": "1.63.0"
  }
}
